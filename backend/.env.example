# Copy this file to .env and fill in real values. .env itself is git-ignored.

# --- PostgreSQL ---
# Primary connection (owner-capable). Points at the existing, already-populated
# supplychain_automation database.
DATABASE_URL=postgresql://localhost:5432/supplychain_automation

# The chatbot's own SELECT-only connection at query time. Created by
# backend/scripts/setup_readonly_role.sql. If unset, the app falls back to
# DATABASE_URL with a loud warning.
CHATBOT_DATABASE_URL=postgresql://chatbot_ro:chatbot_ro_local_dev@localhost:5432/supplychain_automation

# --- OpenAI (text-to-SQL + answer generation) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Guard / execution limits ---
CHATBOT_MAX_ROWS=200
CHATBOT_STATEMENT_TIMEOUT_MS=8000

# --- CORS (comma-separated origins allowed to call the API) ---
CORS_ORIGINS=http://localhost:5173
